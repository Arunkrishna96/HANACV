<Plan ID="ID_2102581_232622F805C5154D923C16F36F42DE52_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT TOP 1000
	"CC_2",
	"FLIGHT_NUMBER",
	"FROM_COUNTRY",
	"DESTINATION",
	SUM("CC_1") AS "CC_1",
	SUM("NUMBER_OF_PASSENGERS") AS "NUMBER_OF_PASSENGERS"
FROM "REVREPRT_1"."Flights::flight"
GROUP BY "CC_2", "FLIGHT_NUMBER", "FROM_COUNTRY", "DESTINATION"]]></SQL>
